# --- Django ---
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True

# --- Base de données (PostgreSQL uniquement, jamais SQLite) ---
# En local : docker compose up -d postgres  (port 5433)
DATABASE_DB=postgres://tierfist:tierfist@localhost:5433/tierfist

# --- Hôtes / CSRF ---
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# --- Médias ---
# En production Railway : monter un volume persistant sur /data/media
MEDIA_ROOT=media
# Taille maximale technique d'un upload d'image, en octets (5 Mo par défaut).
# Limite technique anti-DoS, ce n'est PAS une règle métier.
MAX_UPLOAD_IMAGE_SIZE=5242880

# --- Cookies (mettre à True derrière HTTPS, c'est le cas sur Railway) ---
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
